{
    "verbose": true,
    "git": {
        "commitMessage": "Release ${version}",
        "tagName": "${version}",
        "tagAnnotation": "Release ${version}"
    },
    "github": {
        "release": false
    },
    "npm": {
        "publish": false
    },
    "hooks": {
        "after:release": "bash scripts/publish-release.sh ${version}"
    }
}