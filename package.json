{
    "name": "tkounter-node-provision",
    "version": "1.1.0",
    "description": "Desktop provisioning tool for TKounter nodes",
    "main": "src/main/main.js",
    "scripts": {
        "dev": "electron .",
        "start": "electron .",
        "pack": "electron-builder --dir",
        "dist": "electron-builder",
        "dist:win": "electron-builder --win nsis"
    },
    "dependencies": {
        "axios": "^1.8.4",
        "electron-store": "^10.0.1",
        "feather-icons": "^4.29.2",
        "ssh2": "^1.16.0"
    },
    "devDependencies": {
        "electron": "^35.1.4",
        "electron-builder": "^25.1.8"
    },
    "build": {
        "appId": "techkovery.tkounter.nodeprovision",
        "productName": "TKounter Node Provision",
        "directories": {
            "output": "dist"
        },
        "files": [
            "src/**/*",
            "node_modules/feather-icons/dist/**/*",
            "package.json"
        ],
        "win": {
            "signAndEditExecutable": false,
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        }
    }
}